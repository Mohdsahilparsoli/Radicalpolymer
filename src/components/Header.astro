---
import { NAV, SITE, img } from '../data/site';
interface Props { active?: string }
const { active = '' } = Astro.props;
---
<div class="top"><div class="wrap">
 <div class="l"><span><i class="fa-solid fa-phone-volume"></i><a href={SITE.phoneHref}>{SITE.phone}</a></span><span><i class="fa-regular fa-envelope"></i><a href={`mailto:${SITE.email}`}>{SITE.email}</a></span><span><i class="fa-solid fa-location-dot"></i>{SITE.addressShort}</span></div>
 <div class="l"><span><i class="fa-regular fa-clock"></i>{SITE.hours}</span><div class="soc">{SITE.social.map((s) => <a href={s.href} aria-label={s.label}><i class={s.icon}></i></a>)}</div></div>
</div></div>

<header class="hdr"><div class="wrap">
 <a href="/" class="logo"><img src="/logo.png" alt="Radical Polymers" /></a>
 <nav class="nav-wrap" aria-label="Main menu"><div class="m-head"><img src="/logo.png" alt="Radical Polymers" /><button class="nav-close" aria-label="Close menu"><i class="fa-solid fa-xmark"></i></button></div><ul class="nav">
  {NAV.map((n) => (
   <li class:list={[{ 'has-dd': n.children, act: n.key === active }]}>
    <a href={n.href}>{n.label}{n.children && <i class="fa-solid fa-angle-down"></i>}</a>
    {n.children && n.feat && (
     <div class:list={['mega', 'p', { ar: n.key === 'areas' }]}>
      {n.children.map((c) => <a class="it" href={c.href}><i class={c.icon}></i>{c.label}</a>)}
      {n.key === 'areas' && <a class="it" href={n.href} style="color:var(--gold)"><i class="fa-solid fa-map-location-dot"></i>All Service Areas</a>}
      <a class="feat" href={n.feat.href}><img src={img(n.feat.img, 600, 80)} alt="" loading="lazy" /><div><b>{n.feat.title}</b><span>{n.feat.sub}</span></div></a>
     </div>
    )}
    {n.children && !n.feat && (
     <div class="mega s">{n.children.map((c) => <a class="it" href={c.href}><i class={c.icon}></i>{c.label}</a>)}</div>
    )}
   </li>
  ))}
 </ul>
 <div class="m-extra"><a href="#" class="btn btn-d" data-open-enquiry>Enquire Now <i class="fa-solid fa-arrow-right"></i></a><a class="ln" href={SITE.phoneHref}><i class="fa-solid fa-phone"></i>{SITE.phone}</a><a class="ln" href={`mailto:${SITE.email}`}><i class="fa-regular fa-envelope"></i>{SITE.email}</a><a class="ln" href={SITE.whatsapp} target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i>Chat on WhatsApp</a></div>
 </nav>
 <div class="hdr-r">
  <div class="hcall"><i class="fa-solid fa-headset"></i><div><small>Need Help? Call Us</small><b>{SITE.phone}</b></div></div>
  <a href="#" class="btn btn-d" data-open-enquiry>Enquire Now <i class="fa-solid fa-arrow-right"></i></a>
  <button class="burger" aria-label="Menu"><i class="fa-solid fa-bars-staggered"></i></button>
 </div>
</div></header>
