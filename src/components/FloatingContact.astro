---
import { site } from '../data/site';
---

<div class="floating-contact">
	<a class="fc-whatsapp" href={site.whatsappHref} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
		<i class="fab fa-whatsapp"></i>
	</a>
	<a class="fc-call" href={site.phoneHref} aria-label={`Call ${site.phone}`}>
		<i class="fas fa-phone-alt"></i>
	</a>
</div>
