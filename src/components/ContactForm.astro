---
// Contact form – posts to /api/contact (Nodemailer) and redirects to /thank-you on success.
---

<form class="contact-form js-ajax-form" method="post" action="/api/contact" data-success-redirect="/thank-you" novalidate>
	<h3>Make Your Request</h3>
	<input type="hidden" name="form_type" value="contact" />
	<div class="hp-field" aria-hidden="true">
		<label>
			Leave this field empty
			<input type="text" name="company_website" tabindex="-1" autocomplete="off" />
		</label>
	</div>

	<div class="row">
		<div class="col-lg-6 col-sm-6">
			<div class="input-group">
				<input
					type="text"
					class="form-control"
					placeholder="Your Name"
					name="name"
					autocomplete="name"
					required
					minlength="2"
					maxlength="100"
					aria-label="Your name"
				/>
				<i class="pbmit-base-icon-user-1"></i>
				<div class="invalid-feedback" data-error-for="name"></div>
			</div>
		</div>
		<div class="col-lg-6 col-sm-6">
			<div class="input-group">
				<input
					type="email"
					class="form-control"
					placeholder="Email Address"
					name="email"
					autocomplete="email"
					required
					maxlength="150"
					aria-label="Email address"
				/>
				<i class="pbmit-base-icon-email"></i>
				<div class="invalid-feedback" data-error-for="email"></div>
			</div>
		</div>
		<div class="col-lg-6 col-sm-6">
			<div class="input-group">
				<input
					type="tel"
					class="form-control"
					placeholder="Your Number"
					name="phone"
					autocomplete="tel"
					required
					pattern="[0-9 +\-\(\)]{7,20}"
					maxlength="20"
					aria-label="Phone number"
				/>
				<i class="pbmit-base-icon-phone-volume-solid"></i>
				<div class="invalid-feedback" data-error-for="phone"></div>
			</div>
		</div>
		<div class="col-lg-6 col-sm-6">
			<div class="input-group">
				<input
					type="text"
					class="form-control"
					placeholder="Subject"
					name="subject"
					required
					minlength="2"
					maxlength="150"
					aria-label="Subject"
				/>
				<i class="pbmit-base-icon-paper-plane"></i>
				<div class="invalid-feedback" data-error-for="subject"></div>
			</div>
		</div>
		<div class="col-lg-12 col-sm-12">
			<div class="input-group">
				<textarea
					class="form-control"
					name="message"
					rows="5"
					placeholder="Message"
					required
					minlength="5"
					maxlength="5000"
					aria-label="Message"
				></textarea>
				<i class="pbmit-base-icon-comment-empty"></i>
				<div class="invalid-feedback" data-error-for="message"></div>
			</div>
		</div>
	</div>

	<button type="submit" class="pbmit-btn pbmit-btn-hover-secondary">
		<span class="btn-label">Send a Message</span>
		<span class="btn-loading d-none">
			<i class="fas fa-circle-notch fa-spin"></i>Sending…
		</span>
	</button>
	<div class="form-status" role="status" aria-live="polite"></div>
</form>
