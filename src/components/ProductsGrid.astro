---
import { PRODUCTS, P } from '../data/content';
import ProductCard from './ProductCard.astro';
import SecHead from './SecHead.astro';
interface Props { slugs?: string[]; title?: string; soft?: boolean; eyebrow?: string; filters?: boolean }
const { slugs, title = 'Explore Our <em>Product Range</em>', soft = true, eyebrow = 'Our Products', filters = false } = Astro.props;
const ps = slugs ? slugs.map((s) => P[s]) : PRODUCTS;
const cols = ps.length === 6 ? 3 : Math.min(ps.length, 5);
const id = 'pg' + Math.random().toString(36).slice(2, 8);
const cats = [['all', 'All Products'], ['seal', 'Sealing'], ['mount', 'Mounting & Vibration'], ['sheet', 'Sheets & Profiles'], ['custom', 'Custom & Molded']];
---
<section class:list={['sec', 'prods', { 'u-soft': soft }]} id={filters ? 'products' : undefined}><div class="wrap">
 <SecHead eyebrow={eyebrow} icon="fa-solid fa-boxes-stacked" title={title}>
  {filters
   ? <div class="filters" slot="side" data-filter={`#${id}`}>{cats.map(([c, n], k) => <button class:list={{ on: k === 0 }} data-f={c}>{n}</button>)}</div>
   : <a slot="side" href="/products/" class="btn btn-d">View All Products <i class="fa-solid fa-arrow-right"></i></a>}
 </SecHead>
 <div class={`pg cols-${cols}`} id={id}>{ps.map((p, k) => <ProductCard product={p} k={k} />)}</div>
 {filters && <div class="center rv" style="margin-top:50px"><a href="/products/" class="btn btn-d">View All Products <i class="fa-solid fa-arrow-right"></i></a></div>}
</div></section>
