---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { site } from '../data/site';

import '../styles/icons.css';
import '../styles/style.css';
import '../styles/responsive.css';

interface Props {
	title?: string;
	description?: string;
	/** Load Swiper (pages with carousels) */
	swiper?: boolean;
	/** Load Slider Revolution (home page hero) */
	revSlider?: boolean;
}

const { title, description = site.description, swiper = false, revSlider = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} – Rubber O-Rings, Gaskets & Seals Manufacturer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(site.logo, Astro.site)} />
		<link rel="icon" type="image/png" href="/images/fevicon.png" />
		<meta name="google-site-verification" content="tNd5oYAUHfV_334LVYI1JWF3qndbYFPA7asIPi_oW0A" />

		<!-- Google Ads (gtag.js) -->
		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAdsId}`}></script>
		<script is:inline define:vars={{ id: site.googleAdsId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', id);
		</script>
		<!-- Google Tag Manager -->
		<script is:inline define:vars={{ gtm: site.gtmId }}>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', gtm);
		</script>
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Yantramanav:wght@300;400;500;700&display=swap" />

		<!-- Vendor CSS (CDN) -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/css/bootstrap.min.css" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lykmapipo/themify-icons@0.1.2/css/themify-icons.css" />
		{swiper && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@7.3.3/swiper-bundle.min.css" />}
		{revSlider && <link rel="stylesheet" href="/css/rs6.css" />}
		<slot name="head" />
	</head>
	<body>
		<noscript>
			<iframe
				src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`}
				height="0"
				width="0"
				style="display:none;visibility:hidden"
			></iframe>
		</noscript>

		<div class="page-wrapper">
			<Header>
				<slot name="hero" />
			</Header>

			<main>
				<slot />
			</main>

			<Footer />
		</div>

		<FloatingContact />

		<!-- Vendor JS (CDN) -->
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
		<script is:inline src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
		<script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/js/bootstrap.min.js"></script>
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/waypoints/4.0.1/jquery.waypoints.min.js"></script>
		{swiper && <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@7.3.3/swiper-bundle.min.js"></script>}

		<!-- Site JS -->
		<script is:inline src="/js/numinate.min.js"></script>
		<script is:inline src="/js/scripts.js"></script>
		{revSlider && (
			<Fragment>
				<script is:inline src="/js/rslider.js"></script>
				<script is:inline src="/js/rbtools.min.js"></script>
				<script is:inline src="/js/rs6.min.js"></script>
			</Fragment>
		)}

		<!-- AJAX forms (Nodemailer API) -->
		<script>
			import '../scripts/forms';
		</script>
	</body>
</html>
