---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBar from '../components/TitleBar.astro';
import { site } from '../data/site';
---

<BaseLayout title="Thank You" description="Thank you for contacting Radical Polymers.">
	<meta slot="head" name="robots" content="noindex" />
	<TitleBar title="Thank You" />

	<section class="section-lg thank-you-section">
		<div class="container">
			<div class="thank-you-card">
				<div class="thank-you-icon">
					<i class="fas fa-check"></i>
				</div>
				<h2>Thank you for your enquiry!</h2>
				<p class="lead-text">
					Grateful greetings from <strong>{site.name}</strong>. We have received your message and our team will get back to you
					within one working day.
				</p>
				<p>Thank you for being part of our rubber manufacturing journey. Your trust fuels our commitment to excellence.</p>
				<div class="thank-you-actions">
					<a href="/" class="pbmit-btn pbmit-btn-hover-secondary">
						<span>Back to Home</span>
					</a>
					<a href="/products" class="pbmit-btn">
						<span>View Products</span>
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
