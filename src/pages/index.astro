---
import BaseLayout from '../layouts/BaseLayout.astro';
import Strip from '../components/Strip.astro';
import ProductsGrid from '../components/ProductsGrid.astro';
import Stats from '../components/Stats.astro';
import Materials from '../components/Materials.astro';
import Timeline from '../components/Timeline.astro';
import IndustriesGrid from '../components/IndustriesGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import BlogSlider from '../components/BlogSlider.astro';
import Faq from '../components/Faq.astro';
import Enquiry from '../components/Enquiry.astro';

const homeFaqs = [
 {
  "q": "Can you manufacture custom-size O-rings and gaskets?",
  "a": "Yes. We develop any size from your drawing or sample, including non-standard dimensions and special profiles."
 },
 {
  "q": "Which rubber materials do you work with?",
  "a": "We work with NBR (Nitrile), EPDM, Silicone, Viton (FKM), Neoprene and Natural Rubber, selected according to temperature, oil and chemical exposure."
 },
 {
  "q": "What is the minimum order quantity (MOQ)?",
  "a": "MOQ depends on the part and whether a new mould is needed. Share your requirement and we'll suggest the most economical option."
 },
 {
  "q": "How long does it take to develop a new part?",
  "a": "Timelines depend on part complexity and mould requirements. We confirm a clear delivery schedule with every quotation."
 },
 {
  "q": "Do you deliver across India?",
  "a": "Yes, we dispatch pan-India from our Ghaziabad facility within the promised time-frame."
 },
 {
  "q": "Can I get samples before placing a bulk order?",
  "a": "Please contact our team with your requirement — we'll discuss sample availability for your specific part."
 },
 {
  "q": "How do I get a quotation?",
  "a": "Fill the enquiry form below, email sales@radicalpolymer.com or call +91 9711114333 — we usually respond within one working day."
 }
];
---
<BaseLayout title="Radical Polymers | Rubber O-Rings, Seals, Gaskets Manufacturer in Ghaziabad" description="Radical Polymers, Ghaziabad – manufacturer of Rubber O-Rings, Seals, Gaskets, Washers, Sheets, Bushes, Profiles, Diaphragms and custom molded rubber parts since 2013." active="home">

<!-- 3. HERO -->
<section class="hero"><div class="wrap">
 <div class="rv in">
  <span class="eyebrow"><i class="fa-solid fa-industry"></i> Rubber Products Manufacturer · Since 2013</span>
  <h1>Rubber Parts That <span class="hl">Perform<svg viewBox="0 0 300 16" preserveAspectRatio="none"><path d="M3 12C80 2 200 2 297 10" stroke="#d39b1f" stroke-width="5" fill="none" stroke-linecap="round"/></svg></span> Under Pressure.</h1>
  <p>O-Rings, Seals, Gaskets, Bushes, Diaphragms and custom molded rubber components — manufactured in Ghaziabad and delivered across India at reasonable rates.</p>
  <ul class="ticks"><li><i class="fa-solid fa-circle-check"></i>Custom sizes developed</li><li><i class="fa-solid fa-circle-check"></i>NBR, EPDM, Silicone, Viton</li><li><i class="fa-solid fa-circle-check"></i>Factory-direct pricing</li><li><i class="fa-solid fa-circle-check"></i>On-time pan-India delivery</li></ul>
  <div class="cta"><a href="#" class="btn btn-d" data-open-enquiry>Request a Quote <i class="fa-solid fa-arrow-right"></i></a><a href="#products" class="btn btn-l"><i class="fa-solid fa-grip"></i> View Products</a></div>
  <div class="trust"><div class="avs"><span>M</span><span>R</span><span>A</span><span>+</span></div><div><span class="st">★★★★★</span><b>350+ Happy Clients</b><small>across automotive &amp; industrial sectors</small></div></div>
 </div>
 <div class="h-vis rv zoom in">
  <div class="h-main img">
   <div class="sl on"><img src="https://images.unsplash.com/photo-1496247749665-49cf5b1022e9?auto=format&fit=crop&w=1400&q=80" alt="Rubber products manufacturing facility"></div>
   <div class="sl"><img src="https://images.unsplash.com/photo-1598299803204-b73796f43289?auto=format&fit=crop&w=1400&q=80" alt="Operator running moulding machine" loading="lazy"></div>
   <div class="sl"><img src="https://images.unsplash.com/photo-1717386255773-1e3037c81788?auto=format&fit=crop&w=1400&q=80" alt="Industrial machine in factory" loading="lazy"></div>
  </div>
  <div class="h-dots"><button class="on" aria-label="Slide 1"></button><button aria-label="Slide 2"></button><button aria-label="Slide 3"></button></div>
  <div class="h-sub img"><img src="https://images.unsplash.com/photo-1759790475932-ac8c04b17727?auto=format&fit=crop&w=600&q=80" alt="Black rubber O-rings"></div>
  <div class="h-badge"><img src="/logo.png" alt=""><div><b>Radical Polymers</b><small>Ghaziabad, U.P.</small></div></div>
  <div class="h-exp"><b>13+</b><span>Years of rubber<br>manufacturing</span></div>
 </div>
</div>
<svg class="wave" viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0 40c240 40 480 40 720 20s480-40 720 0v20H0z" fill="#fff"/></svg>
</section>

<Strip />

<!-- 5. ABOUT -->
<section class="sec about"><div class="wrap">
 <div class="ab-pics rv">
  <div class="p1 img"><img src="https://images.unsplash.com/photo-1581091212991-8891c7d4bd9b?auto=format&fit=crop&w=1000&q=80" alt="Engineers in manufacturing unit" loading="lazy"></div>
  <a href="/manufacturing-facility/" class="play" aria-label="Facility tour"><i class="fa-solid fa-play"></i></a>
  <div class="p2 img"><img src="https://images.unsplash.com/photo-1699466622736-36c7b7893745?auto=format&fit=crop&w=800&q=80" alt="Box of rubber rings" loading="lazy"></div>
  <div class="yr"><b>2013</b><span>Established in Ghaziabad</span></div>
 </div>
 <div class="rv d1" data-tabs>
  <span class="eyebrow"><i class="fa-solid fa-building"></i> Who We Are</span>
  <h2 class="h2">Welcome To <em>Radical Polymers</em></h2>
  <p>Established as a Proprietor firm in the year 2013, “Radical Polymers” is a leading Manufacturer of a wide range of Rubber Gaskets, Rubber O-Rings, Rubber Seals, etc. Situated in Ghaziabad (Uttar Pradesh, India), we have constructed a wide and well-functional infrastructural unit that plays an important role in the growth of our company. We offer these products at reasonable rates and deliver them within the promised time-frame.</p>
  <div class="mv-tabs"><button class="on" data-t="0"><i class="fa-solid fa-bullseye"></i>Our Mission</button><button data-t="1"><i class="fa-regular fa-eye"></i>Our Vision</button><button data-t="2"><i class="fa-regular fa-gem"></i>Our Values</button></div>
  <p class="mv-p on" data-p="0">To supply reliable rubber components at reasonable rates and deliver them within the promised time-frame — every single order.</p>
  <p class="mv-p" data-p="1">To be the first-choice rubber parts partner for Indian manufacturers, known for quality, flexibility and trust.</p>
  <p class="mv-p" data-p="2">Honest pricing, consistent quality, quick response and long-term relationships with every client.</p>
  <div class="ab-feat"><div><i class="fa-solid fa-award"></i><div><b>Quality Products</b><span>Consistent, inspected output</span></div></div><div><i class="fa-solid fa-hand-holding-dollar"></i><div><b>Reasonable Rates</b><span>Factory-direct pricing</span></div></div><div><i class="fa-solid fa-users-gear"></i><div><b>Expert Team</b><span>80+ skilled members</span></div></div><div><i class="fa-solid fa-clock"></i><div><b>Timely Delivery</b><span>Within promised time-frame</span></div></div></div>
  <div class="owner"><div class="av">S</div><div><b>Mr. Sahil Sharma</b><span>Proprietor, Radical Polymers</span></div><a href="/about-us/" class="btn btn-g" style="margin-left:auto">Read More <i class="fa-solid fa-arrow-right"></i></a></div>
 </div>
</div></section>

<ProductsGrid filters />

<Stats />

<!-- 8. WHY CHOOSE US -->
<section class="sec why"><div class="wrap">
 <div class="why-img img rv"><img src="https://images.unsplash.com/photo-1695603414685-af28aff0f9d2?auto=format&fit=crop&w=1100&q=80" alt="Technicians working on machine" loading="lazy"><div class="cap"><i class="fa-solid fa-handshake"></i><div><b>A Genuine Manufacturer</b><span>Trusted by 350+ clients since 2013</span></div></div></div>
 <div class="rv d1">
  <span class="eyebrow"><i class="fa-solid fa-star"></i> Why Choose Us</span>
  <h2 class="h2">The <em>Radical</em> Advantage</h2>
  <p class="lead">We are a genuine manufacturer, not a trader — which means better control over quality, pricing and delivery for every order, big or small.</p>
  <div class="wg">
   <div class="wc"><i class="fa-solid fa-industry"></i><h3>Direct Manufacturer</h3><p>Factory-direct pricing with full process control.</p></div>
   <div class="wc"><i class="fa-solid fa-ruler-combined"></i><h3>Any Size Developed</h3><p>We develop any size or profile from your drawing or sample.</p></div>
   <div class="wc"><i class="fa-solid fa-flask-vial"></i><h3>Right Compound</h3><p>NBR, EPDM, Silicone, Viton, Neoprene — matched to your application.</p></div>
   <div class="wc"><i class="fa-solid fa-truck-fast"></i><h3>On-Time Delivery</h3><p>Committed timelines and dispatch across India.</p></div>
  </div>
 </div>
</div></section>

<Materials />

<Timeline />

<IndustriesGrid />

<!-- 12. FACILITY GALLERY -->
<section class="sec"><div class="wrap">
 <div class="sec-head rv"><div><span class="eyebrow"><i class="fa-solid fa-warehouse"></i> Manufacturing Facility</span><h2 class="h2" style="margin:0">Inside Our <em>Facility</em></h2></div><a href="/manufacturing-facility/" class="btn btn-l">Explore Facility <i class="fa-solid fa-arrow-right"></i></a></div>
 <div class="gal rv">
  <div class="img" data-lb><img src="https://images.unsplash.com/photo-1496247749665-49cf5b1022e9?auto=format&fit=crop&w=1200&q=80" alt="Production floor" loading="lazy"><span class="zoom"><i class="fa-solid fa-expand"></i></span><div class="lbl"><b>Production Floor</b><span>Moulding &amp; finishing</span></div></div>
  <div class="img" data-lb><img src="https://images.unsplash.com/photo-1716191299980-a6e8827ba10b?auto=format&fit=crop&w=800&q=80" alt="Automation" loading="lazy"><span class="zoom"><i class="fa-solid fa-expand"></i></span><div class="lbl"><b>Modern Machines</b><span>20+ equipment</span></div></div>
  <div class="img" data-lb><img src="https://images.unsplash.com/photo-1758873263563-5ba4aa330799?auto=format&fit=crop&w=800&q=80" alt="Measurement" loading="lazy"><span class="zoom"><i class="fa-solid fa-expand"></i></span><div class="lbl"><b>Precision Checks</b><span>Dimensional inspection</span></div></div>
  <div class="img" data-lb><img src="https://images.unsplash.com/photo-1589793463357-5fb813435467?auto=format&fit=crop&w=800&q=80" alt="Team at work" loading="lazy"><span class="zoom"><i class="fa-solid fa-expand"></i></span><div class="lbl"><b>Skilled Team</b><span>80+ members</span></div></div>
  <div class="img" data-lb><img src="https://images.unsplash.com/photo-1721937127582-ed331de95a04?auto=format&fit=crop&w=800&q=80" alt="Warehouse" loading="lazy"><span class="zoom"><i class="fa-solid fa-expand"></i></span><div class="lbl"><b>Packing &amp; Dispatch</b><span>Pan-India delivery</span></div></div>
 </div>
</div></section>

<!-- 13. QUALITY -->
<section class="sec qual" style="padding-top:0"><div class="wrap">
 <div class="rv"><span class="eyebrow"><i class="fa-solid fa-microscope"></i> Quality &amp; Testing</span><h2 class="h2">Quality That <em>Doesn't Leak</em></h2>
  <p class="lead">Every batch is checked at multiple stages before it leaves our Ghaziabad facility.</p>
  <ul class="q-list">
   <li><div class="qi"><i class="fa-solid fa-flask-vial"></i></div><div><b>Raw Material Check</b><span>Compound verified before production begins.</span></div></li>
   <li><div class="qi"><i class="fa-solid fa-ruler"></i></div><div><b>Dimensional Accuracy</b><span>Sizes checked against drawing tolerances.</span></div></li>
   <li><div class="qi"><i class="fa-solid fa-gauge-high"></i></div><div><b>Hardness Testing</b><span>Shore A hardness verified for consistency.</span></div></li>
   <li><div class="qi"><i class="fa-solid fa-eye"></i></div><div><b>Final Visual Inspection</b><span>Flash, finish &amp; defects checked before packing.</span></div></li>
  </ul></div>
 <div class="q-vis img rv d1"><img src="https://images.unsplash.com/photo-1747999827332-163aa33cd597?auto=format&fit=crop&w=1100&q=80" alt="Quality inspection of component" loading="lazy">
  <div class="q-card"><h3>Why clients stay with us</h3>
   <div class="meter"><div><span>Product Quality</span><span>98%</span></div><div class="tr"><i style="--w:98%"></i></div></div>
   <div class="meter"><div><span>On-Time Delivery</span><span>95%</span></div><div class="tr"><i style="--w:95%"></i></div></div>
   <div class="meter"><div><span>Custom Development</span><span>92%</span></div><div class="tr"><i style="--w:92%"></i></div></div>
  </div>
 </div>
</div></section>

<!-- 14. CTA BANNER -->
<section style="padding-bottom:110px"><div class="wrap"><div class="cta-b rv">
 <div class="img"><img src="https://images.unsplash.com/photo-1735494033576-9c882e80504c?auto=format&fit=crop&w=1800&q=75" alt="" loading="lazy"></div>
 <div><h2>Need a <em>Custom Rubber Part</em>? Send Your Drawing or Sample.</h2><p>We develop moulds and deliver precision rubber components that match your exact requirement.</p></div>
 <div class="acts"><a href="#" class="btn btn-g" data-open-enquiry>Get Free Quote <i class="fa-solid fa-arrow-right"></i></a><a href="tel:+919711114333" class="btn btn-l"><i class="fa-solid fa-phone"></i> +91 9711114333</a></div>
</div></div></section>

<Testimonials />

<BlogSlider />

<Faq items={homeFaqs} image="clipboard" pt0 />

<Enquiry />

</BaseLayout>
