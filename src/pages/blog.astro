---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBar from '../components/TitleBar.astro';
---

<BaseLayout title="Blog">
	<TitleBar title="Blog" />

	<!-- Page Content -->
	<div class="page-content pbmit-bg-color-light">
		<section class="section-lg" style="background-color:#f2f3f5">
			<div class="container">
				<div class="pbmit-heading-subheading text-center">
					<h4 class="pbmit-subtitle">Latest News</h4>
					<h2 class="pbmit-title">Our latest Blog & News</h2>
				</div>
				<div class="row">
					<div class="col-md-4">
						<article class="pbmit-blog-style-1">
							<div class="post-item">
								<div class="pbmit-featured-container">
									<div class="pbmit-featured-wrapper">
										<img src="/images/b.jpg" class="img-fluid" alt="" />
									</div>
									<div class="pbmit-meta-container">
										<div class="pbmit-meta-date-wrapper">
											<span>
												<i class="pbmit-base-icon-calendar-1"></i>June 15, 2023
											</span>
										</div>
									</div>
								</div>
								<div class="pbminfotech-box-content">
									<div class="pbminfotech-box-container">
										<br />
										<h3 class="pbmit-post-title">
											<a href="/blog/">Biggest super structures made of steel</a>
										</h3>

										<div class="pbmit-service-btn">
											<a class="btn-arrow" href="/blog/">
												Read More
											</a>
										</div>
									</div>
								</div>
							</div>
						</article>
					</div>
					<div class="col-md-4">
						<article class="pbmit-blog-style-1">
							<div class="post-item">
								<div class="pbmit-featured-container">
									<div class="pbmit-featured-wrapper">
										<img src="/images/b1.jpg" class="img-fluid" alt="" />
									</div>
									<div class="pbmit-meta-container">
										<div class="pbmit-meta-date-wrapper">
											<span>
												<i class="pbmit-base-icon-calendar-1"></i>June 15, 2023
											</span>
										</div>
									</div>
								</div>
								<div class="pbminfotech-box-content">
									<div class="pbminfotech-box-container">
										<br />
										<h3 class="pbmit-post-title">
											<a href="/blog/">Which steeel is used for oil drills</a>
										</h3>

										<div class="pbmit-service-btn">
											<a class="btn-arrow" href="/blog/">
												Read More
											</a>
										</div>
									</div>
								</div>
							</div>
						</article>
					</div>
					<div class="col-md-4">
						<article class="pbmit-blog-style-1">
							<div class="post-item">
								<div class="pbmit-featured-container">
									<div class="pbmit-featured-wrapper">
										<img src="/images/b2.jpg" class="img-fluid" alt="" />
									</div>
									<div class="pbmit-meta-container">
										<div class="pbmit-meta-date-wrapper">
											<span>
												<i class="pbmit-base-icon-calendar-1"></i>June 15, 2023
											</span>
										</div>
									</div>
								</div>
								<div class="pbminfotech-box-content">
									<div class="pbminfotech-box-container">
										<br />
										<h3 class="pbmit-post-title">
											<a href="/blog/">Industrial coating for metallic surfaces</a>
										</h3>

										<div class="pbmit-service-btn">
											<a class="btn-arrow" href="/blog/">
												Read More
											</a>
										</div>
									</div>
								</div>
							</div>
						</article>
					</div>
				</div>
			</div>
		</section>
	</div>
	<!-- Page Content End -->
</BaseLayout>
