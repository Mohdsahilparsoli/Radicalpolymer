---
// One template for every article. Later: getStaticPaths() pulls posts from WordPress.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogSlider from '../../components/BlogSlider.astro';
import Cta from '../../components/Cta.astro';
import { BLOG, PRODUCTS, type Post } from '../../data/content';
import { SITE, img, url } from '../../data/site';

export function getStaticPaths() {
  return BLOG.map((b) => ({ params: { slug: b.slug }, props: { post: b } }));
}
const { post: b } = Astro.props as { post: Post };
const others = BLOG.filter((x) => x.slug !== b.slug);
const cats = [...new Set(BLOG.map((x) => x.cat))].sort();
const share = encodeURIComponent(new URL(url.post(b.slug), Astro.site).href);
---
<BaseLayout title={`${b.title} | Radical Polymers Blog`} description={b.excerpt} active="blog">
 <PageHero crumbs={[{ label: 'Blog', href: '/blog/' }, { label: b.cat }]} eyebrow={b.cat} eyebrowIcon="fa-solid fa-tag" title={b.title} sub={b.excerpt} image={b.img} card={false} actions={false}>
  <div class="post-meta"><span><i class="fa-regular fa-user"></i>Radical Polymers Team</span><span><i class="fa-regular fa-calendar"></i>{b.date}</span><span><i class="fa-regular fa-clock"></i>{b.mins} min read</span></div>
 </PageHero>
 <section class="sec"><div class="wrap post">
  <article>
   <div class="post-hero-img img rv"><img src={img(b.img, 1400)} alt={b.title} /></div>
   <div class="article rv" set:html={b.body} />
   <div class="share"><b>Share:</b>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener" aria-label="Share on Facebook"><i class="fa-brands fa-facebook-f"></i></a>
    <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${share}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
    <a href={`https://wa.me/?text=${share}`} target="_blank" rel="noopener" aria-label="Share on WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
    <a href={`mailto:?subject=${encodeURIComponent(b.title)}&body=${share}`} aria-label="Share by email"><i class="fa-regular fa-envelope"></i></a>
   </div>
  </article>
  <aside class="pd-side">
   <div class="sb-box rp"><h4>Recent Articles</h4>{others.slice(0, 4).map((x) => <a href={url.post(x.slug)}><div class="img"><img src={img(x.img, 200)} alt="" loading="lazy" /></div><div><b>{x.title}</b><small>{x.date}</small></div></a>)}</div>
   <div class="sb-box"><h4>Categories</h4><div class="tags">{cats.map((c) => <a href="/blog/">{c}</a>)}</div></div>
   <div class="sb-cta"><div class="img"><img src={img('operator', 600)} alt="" loading="lazy" /></div><h4>Need Help Choosing a Part?</h4><p>Talk to our team — we'll recommend the right size and compound.</p><a class="ph" href={SITE.phoneHref}><i class="fa-solid fa-phone"></i>{SITE.phone}</a><a href="#" class="btn btn-g" data-open-enquiry>Get a Free Quote</a></div>
   <div class="sb-box sb-links"><h4>Our Products</h4>{PRODUCTS.slice(0, 6).map((p) => <a href={url.product(p.slug)}>{p.name}<i class="fa-solid fa-chevron-right"></i></a>)}<a href="/products/" style="color:var(--gold)">View All Products<i class="fa-solid fa-chevron-right"></i></a></div>
  </aside>
 </div></section>
 <BlogSlider exclude={b.slug} title="More <em>Articles</em>" soft />
 <Cta title="Looking for <em>Quality Rubber Parts</em>?" sub="Standard sizes or custom development — get a quote today." />
</BaseLayout>
