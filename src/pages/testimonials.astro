---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBar from '../components/TitleBar.astro';
---

<BaseLayout title="Testimonials" swiper>
	<TitleBar title="Testimonials" />

	<!-- Page Content -->
	<div class="page-content pbmit-bg-color-light">
		<section class="overflow-hidden">
			<div class="container">
				<div class="row">
					<div class="col-lg-5 col-md-12">
						<div class="testimonial-bg-one">
							<div class="pbminfotech-ele-fid-style-5">
								<div class="pbmit-fld-contents d-flex align-items-center">
									<div class="pbmit-sbox-icon-wrapper">
										<i class="pbmit-colza-icon pbmit-colza-icon-labor-man"></i>
									</div>
									<div class="pbmit-fld-wrap">
										<h4 class="pbmit-fid-inner">
											<span
												class="pbmit-number-rotate numinate"
												data-appear-animation="animateDigits"
												data-from="0"
												data-to="350"
												data-interval="5"
												data-before=""
												data-before-style=""
												data-after=""
												data-after-style=""
											>
												350
											</span>
											<span class="pbmit-fid">
												<sup>+</sup>
											</span>
										</h4>
										<div class="pbmit-fid-title">
											<span>Happy Clients</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-7 col-md-12">
						<div class="testimonial-box-one">
							<div class="pbmit-heading-subheading">
								<h4 class="pbmit-subtitle">Testimonial</h4>
								<h2 class="pbmit-title">What clients say about</h2>
							</div>
							<div
								class="swiper-slider"
								data-loop="false"
								data-autoplay="true"
								data-dots="true"
								data-arrows="false"
								data-columns="1"
								data-margin="30"
								data-effect="slide"
							>
								<div class="swiper-wrapper">
									<!-- slide 1 -->
									<div class="swiper-slide">
										<article class="pbmit-testimonial-style-2">
											<div class="pbminfotech-post-item">
												<div class="pbminfotech-box-content">
													<div class="pbminfotech-box-star-ratings">
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star"></i>
													</div>
													<div class="pbminfotech-testimonial-wrapper">
														<div class="pbminfotech-box-desc">
															<blockquote class="pbminfotech-testimonial-text">
																<p>
																	“Amazing products satisfied and recommended to use Radical Polymers
																	👍👍👍👍 … ”
																</p>
															</blockquote>
														</div>
														<div class="pbminfotech-author-wrapper d-flex">
															<div class="pbminfotech-box-img">
																<div class="pbmit-featured-wrapper"></div>
															</div>
															<div class="pbminfotech-box-author">
																<h3 class="pbminfotech-box-title">Mohit</h3>
																<div class="pbminfotech-testimonial-detail">Customer</div>
															</div>
														</div>
													</div>
												</div>
											</div>
										</article>
									</div>
									<!-- slide 2 -->
									<div class="swiper-slide">
										<article class="pbmit-testimonial-style-2">
											<div class="pbminfotech-post-item">
												<div class="pbminfotech-box-content">
													<div class="pbminfotech-box-star-ratings">
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star pbmit-active"></i>
													</div>
													<div class="pbminfotech-testimonial-wrapper">
														<div class="pbminfotech-box-desc">
															<blockquote class="pbminfotech-testimonial-text">
																<p>
																	“Unmatched purchasing experience, quality is too good same as original,
																	they can develop any size you ask”
																</p>
															</blockquote>
														</div>
														<div class="pbminfotech-author-wrapper d-flex">
															<div class="pbminfotech-box-img">
																<div class="pbmit-featured-wrapper"></div>
															</div>
															<div class="pbminfotech-box-author">
																<h3 class="pbminfotech-box-title">Rohan</h3>
																<div class="pbminfotech-testimonial-detail">Customer</div>
															</div>
														</div>
													</div>
												</div>
											</div>
										</article>
									</div>
									<!-- slide 3 -->
									<div class="swiper-slide">
										<article class="pbmit-testimonial-style-2">
											<div class="pbminfotech-post-item">
												<div class="pbminfotech-box-content">
													<div class="pbminfotech-box-star-ratings">
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star pbmit-active"></i>
														<i class="pbmit-base-icon-star"></i>
													</div>
													<div class="pbminfotech-testimonial-wrapper">
														<div class="pbminfotech-box-desc">
															<blockquote class="pbminfotech-testimonial-text">
																<p>
																	“One of the best in terms of sales ,services,pricing and delivery . A
																	genuine manufacturer,fully recommended! ”
																</p>
															</blockquote>
														</div>
														<div class="pbminfotech-author-wrapper d-flex">
															<div class="pbminfotech-box-img">
																<div class="pbmit-featured-wrapper"></div>
															</div>
															<div class="pbminfotech-box-author">
																<h3 class="pbminfotech-box-title">Aniket</h3>
																<div class="pbminfotech-testimonial-detail">Customer</div>
															</div>
														</div>
													</div>
												</div>
											</div>
										</article>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- Testimonial End -->
	</div>
	<!-- Page Content End -->
</BaseLayout>
