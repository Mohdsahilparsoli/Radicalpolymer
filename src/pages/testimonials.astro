---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SecHead from '../components/SecHead.astro';
import FeatureCards from '../components/FeatureCards.astro';
import Stats from '../components/Stats.astro';
import Split from '../components/Split.astro';
import ProductsGrid from '../components/ProductsGrid.astro';
import Cta from '../components/Cta.astro';
import Enquiry from '../components/Enquiry.astro';
import { TESTIMONIALS } from '../data/content';
import { SITE } from '../data/site';
const vals = [
  { icon: 'fa-solid fa-award', title: 'Product Quality', text: '“Quality is as good as the original.”' },
  { icon: 'fa-solid fa-ruler-combined', title: 'Any Size Developed', text: '“They can develop any size you ask.”' },
  { icon: 'fa-solid fa-indian-rupee-sign', title: 'Fair Pricing', text: '“One of the best in terms of pricing.”' },
  { icon: 'fa-solid fa-truck-fast', title: 'Reliable Delivery', text: '“Best in sales, service and delivery.”' },
];
---
<BaseLayout title="Client Testimonials | Radical Polymers Reviews" description="Read what clients say about Radical Polymers rubber O-rings, seals, gaskets and custom parts — quality, pricing and delivery." active="testimonials">
 <PageHero crumbs={[{ label: 'Testimonials' }]} eyebrow="Testimonials" eyebrowIcon="fa-solid fa-comments" title="What Our <em>Clients Say</em>" sub="Real feedback from clients who trust Radical Polymers for their rubber components." image="handshake" chips={['5.0 Rated', '350+ Happy Clients', 'Repeat Business']} />
 <section class="sec"><div class="wrap"><div class="rate-band rv"><div class="big">5.0</div><div><h3>Rated by our happy clients</h3><p>Clients value our product quality, ability to develop any size, fair pricing and on-time delivery.</p></div><div class="st">★★★★★</div></div></div></section>
 <section class="sec pt-0"><div class="wrap">
  <SecHead eyebrow="Reviews" icon="fa-solid fa-star" title="Client <em>Reviews</em>" />
  <div class="tgrid">{TESTIMONIALS.map((t, k) => <div class={`tbig rv d${k}`}><i class="fa-solid fa-quote-right qm"></i><div class="st">★★★★★</div><p>“{t.quote}”</p><div class="who"><div class="av">{t.initial}</div><div><b>{t.name}</b><span>{t.role}</span></div></div></div>)}</div>
 </div></section>
 <section class="sec u-soft"><div class="wrap"><SecHead eyebrow="What Clients Value" icon="fa-solid fa-heart" title="Why Clients <em>Recommend Us</em>" center /><FeatureCards items={vals} cols={4} /></div></section>
 <Stats bg="assembly" />
 <Split image="deal" rev sm>
  <span class="eyebrow"><i class="fa-solid fa-pen"></i> Share Your Feedback</span><h2 class="h2">Worked With Us? <em>Tell Us How We Did</em></h2>
  <p>Your feedback helps us improve and helps other buyers choose with confidence. Share your experience with our team by email or WhatsApp.</p>
  <div style="display:flex;gap:12px;flex-wrap:wrap"><a href={`mailto:${SITE.email}?subject=Feedback`} class="btn btn-d"><i class="fa-regular fa-envelope"></i> Email Feedback</a><a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn btn-l"><i class="fa-brands fa-whatsapp" style="color:#25d366"></i> WhatsApp</a></div>
 </Split>
 <ProductsGrid title="Products Our <em>Clients Buy</em>" />
 <Cta title="Join Our <em>Happy Clients</em>" sub="Get a quote for your rubber parts today." />
 <Enquiry />
</BaseLayout>
