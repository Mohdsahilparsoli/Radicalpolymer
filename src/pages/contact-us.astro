---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Enquiry from '../components/Enquiry.astro';
import SecHead from '../components/SecHead.astro';
import FeatureCards from '../components/FeatureCards.astro';
import Split from '../components/Split.astro';
import TickList from '../components/TickList.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { GENERAL_FAQS } from '../data/content';
import { SITE } from '../data/site';
const help = [
  { icon: 'fa-solid fa-file-invoice', title: 'Request a Quote', text: 'Share product, size, material and quantity.' },
  { icon: 'fa-solid fa-pen-ruler', title: 'Custom Development', text: 'Send a drawing or sample for a new part.' },
  { icon: 'fa-solid fa-flask', title: 'Material Advice', text: 'Ask which compound suits your application.' },
  { icon: 'fa-solid fa-truck-fast', title: 'Order Status', text: 'Check on an existing order or dispatch.' },
];
---
<BaseLayout title="Contact Us | Radical Polymers, Ghaziabad – +91 9711114333" description="Contact Radical Polymers, 155-A Model Town West, Ghaziabad. Call +91 9711114333 or email sales@radicalpolymer.com for rubber products quotes." active="contact">
 <PageHero crumbs={[{ label: 'Contact Us' }]} eyebrow="Contact Us" eyebrowIcon="fa-solid fa-headset" title="Let’s Talk About Your <em>Requirement</em>" sub="Call, email or send an enquiry — our team usually responds within one working day." image="deal" chips={[SITE.phone, SITE.email, 'Ghaziabad, U.P.']} card={false} />
 <section class="sec"><div class="wrap"><div class="cinfo">
  <div class="ci-c rv"><i class="fa-solid fa-phone"></i><h3>Call Us</h3><a href={SITE.phoneHref}>{SITE.phone}</a><p>{SITE.hours}</p></div>
  <div class="ci-c rv d1"><i class="fa-regular fa-envelope"></i><h3>Email Us</h3><a href={`mailto:${SITE.email}`}>{SITE.email}</a><p>Quotes &amp; enquiries</p></div>
  <div class="ci-c rv d2"><i class="fa-solid fa-location-dot"></i><h3>Visit Us</h3><p>155-A Model Town West,<br />Ghaziabad, Uttar Pradesh</p></div>
  <div class="ci-c rv d3"><i class="fa-brands fa-whatsapp"></i><h3>WhatsApp</h3><a href={SITE.whatsapp} target="_blank" rel="noopener">Chat with us</a><p>Share drawings &amp; photos</p></div>
 </div></div></section>
 <Enquiry noTopPad />
 <section class="sec u-soft"><div class="wrap"><SecHead eyebrow="How We Can Help" icon="fa-solid fa-hand-holding-heart" title="What You Can <em>Contact Us For</em>" center /><FeatureCards items={help} cols={4} /></div></section>
 <Split image="designteam" sm badge={['24h', 'Typical response time', true]}>
  <span class="eyebrow"><i class="fa-solid fa-lightbulb"></i> Quick Tip</span><h2 class="h2">Get a Faster, <em>More Accurate Quote</em></h2>
  <p>Include these details in your enquiry and we can respond faster with the right price and lead time:</p>
  <TickList items={['Product type &amp; size', 'Drawing or photo of sample', 'Material / application', 'Operating temperature', 'Quantity required', 'Delivery location']} />
  <a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn btn-d"><i class="fa-brands fa-whatsapp"></i> Send on WhatsApp</a>
 </Split>
 <Faq items={GENERAL_FAQS} image="clipboard" soft />
 <Cta title="Prefer to <em>Talk Directly</em>?" sub="Call our sales team for quick help with your requirement." image="handshake" />
</BaseLayout>
